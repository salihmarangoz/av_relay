[Desktop Entry]
Type=Application
Name=AV Relay
GenericName=Camera and Microphone Relay
Comment=Use another computer's camera and microphone on this one
Exec=av-relay
Icon=io.github.salihmarangoz.avrelay
Terminal=false
Categories=AudioVideo;Video;Audio;Network;
Keywords=camera;webcam;microphone;mic;relay;mac;macbook;video call;
StartupNotify=true
SingleMainWindow=true
X-GNOME-Autostart-enabled=true
